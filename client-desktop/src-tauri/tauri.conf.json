{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpsWarden",
  "version": "1.0.19",
  "identifier": "com.opswarden.desktop",
  "build": {
    "beforeDevCommand": "node scripts/start-web-dev.mjs",
    "devUrl": "http://localhost:4242",
    "frontendDist": "http://localhost:8081"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OpsWarden",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.giphy.com; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws: wss:",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
