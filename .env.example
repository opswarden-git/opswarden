DATABASE_URL="postgres://opswarden:opswarden@localhost:5433/opswarden"
JWT_SECRET="DEV_ONLY_CHANGE_ME"

# --- Automatisation Team : coffre de secrets ---
# Cle AES-256 du coffre (64 hex = 32 octets). Obligatoire en production.
# Seuls les builds debug natifs possedent un fallback de developpement.
# Generer : openssl rand -hex 32
OPSWARDEN_VAULT_KEY=""
# Les secrets GitHub/HTTP et les règles se configurent dans la Team ; aucune
# variable d'environnement métier globale n'est acceptée.

# --- Optional GIF API for development ---
# Cle serveur GIPHY pour la recherche de GIFs dans la timeline.
# Ne jamais exposer au client web ; le serveur doit proxy les appels.
GIPHY_API_KEY=""

# --- OAuth Google (optionnel, requis pour les boutons Google du client) ---
# Redirect URI a declarer dans Google Cloud Console:
# http://localhost:8080/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:8080/api/auth/google/callback"

# --- OAuth GitHub pour l'inscription et la connexion utilisateur ---
# Utiliser une application d'identité distincte de l'intégration Automation Team.
GITHUB_AUTH_CLIENT_ID=""
GITHUB_AUTH_CLIENT_SECRET=""
GITHUB_AUTH_REDIRECT_URI="http://localhost:8080/api/auth/github/callback"

# --- OAuth GitHub pour les connexions Automation Team (optionnel) ---
# Utiliser de préférence une GitHub App avec expiration des user access tokens
# activée afin que GitHub fournisse aussi un refresh token.
# Callback à déclarer:
# http://localhost:8080/api/service-oauth/github/callback
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""
GITHUB_OAUTH_REDIRECT_URI="http://localhost:8080/api/service-oauth/github/callback"
OPSWARDEN_WEB_ORIGIN="http://localhost:4242"
# Exact comma-separated browser origins accepted by the WebSocket handshake.
# Originless native/service clients remain supported.
OPSWARDEN_WS_ALLOWED_ORIGINS="http://localhost:4242,http://localhost:8081"
# Number of reverse proxies controlled by this deployment. Keep 0 for direct
# server exposure; Compose supplies 1 for its client_web Next.js proxy.
OPSWARDEN_TRUSTED_PROXY_HOPS="0"
# Optional Compose-only override. Compose serves the web client on 8081 by
# default while `just web-dev` keeps using OPSWARDEN_WEB_ORIGIN above.
OPSWARDEN_COMPOSE_WEB_ORIGIN="http://localhost:8081"
# Socket the server listens on. Leave unset for the 0.0.0.0:8080 default. Set it
# to run `just dev` natively while the Compose stack still holds 8080, e.g.
# OPSWARDEN_BIND_ADDR=0.0.0.0:8090 just dev
OPSWARDEN_BIND_ADDR="0.0.0.0:8080"
# Coarse ceiling on unauthenticated /api/auth/* per client address, counted per
# replica. Loose on purpose: a proxy that forwards no client address — Compose's
# Next client is one — puts every visitor in this single bucket.
OPSWARDEN_AUTH_RATE_LIMIT_ATTEMPTS="600"
# Failed sign-ins allowed per account. This is the limit that bounds credential
# stuffing; no proxy topology can blur which account is being guessed at.
# Successful sign-ins never spend it.
OPSWARDEN_AUTH_RATE_LIMIT_PER_ACCOUNT="10"
OPSWARDEN_AUTH_RATE_LIMIT_WINDOW_SECONDS="300"

# --- Reproducible single-Team demo fixture ---
# `python3 tooling/demo.py --help` uses these values for both local and guarded
# production runs. Keep real values only in the ignored `.env` file.
DEMO_LOCAL_API_ORIGIN="http://localhost:8080"
DEMO_PRODUCTION_API_ORIGIN="https://api.opswarden.dev"
# Target-specific values override the shared identity below when local and
# production intentionally use different onboarding accounts or Team names.
DEMO_LOCAL_MANAGER_EMAIL=""
DEMO_PRODUCTION_MANAGER_EMAIL=""
# Optional short-lived bearer token for OAuth Managers. Prefer --prompt-token
# interactively; never commit a real token.
DEMO_LOCAL_MANAGER_TOKEN=""
DEMO_PRODUCTION_MANAGER_TOKEN=""
DEMO_MANAGER_EMAIL=""
DEMO_RESPONDER_EMAIL="responder.demo@opswarden.local"
DEMO_OBSERVER_EMAIL="observer.demo@opswarden.local"
DEMO_CONTRACTOR_EMAIL="contractor.demo@opswarden.local"
DEMO_PASSWORD=""
DEMO_LOCAL_PASSWORD=""
DEMO_TEAM_NAME="OpsWarden"
DEMO_LOCAL_TEAM_NAME=""
DEMO_PRODUCTION_TEAM_NAME=""
# Optional disambiguation when the Manager owns several Teams with this name.
DEMO_LOCAL_TEAM_ID=""
DEMO_PRODUCTION_TEAM_ID=""

DEMO_GITHUB_REPOSITORY="opswarden-git/opswarden-demo"
DEMO_GITHUB_BRANCH="main"
DEMO_GITHUB_WORKFLOW="OpsWarden Demo CI"
DEMO_GITLAB_PROJECT="romeo.cavazza/opswarden-demo"
DEMO_GITLAB_BRANCH="main"
DEMO_GITLAB_PIPELINE="CI"

# Generate independent high-entropy values; never reuse an OAuth client secret.
DEMO_GITHUB_WEBHOOK_SECRET=""
DEMO_GITLAB_WEBHOOK_SECRET=""
DEMO_GENERIC_WEBHOOK_SECRET=""
DEMO_ALERTMANAGER_WEBHOOK_SECRET=""

DEMO_HTTP_ENDPOINT=""
DEMO_SMTP_HOST=""
DEMO_SMTP_PORT="587"
DEMO_SMTP_USERNAME=""
DEMO_SMTP_PASSWORD=""
DEMO_EMAIL_FROM=""
DEMO_EMAIL_TO=""

# Required only by guarded production seed/deseed commands.
DEMO_KUBECONFIG=""
DEMO_KUBE_CONTEXT="do-fra1-opswarden-cluster"
DEMO_KUBE_NAMESPACE="default"
DEMO_DB_NAME="opswarden"
DEMO_LOCAL_DB_USER="opswarden"
DEMO_PRODUCTION_DB_USER="postgres"
