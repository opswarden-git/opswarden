# --- server/Dockerfile ---

# ---- build ----
FROM rust:1-bookworm@sha256:77fac8b98f9f46062bb680b6d25d5bcaabfc400143952ebc572e924bcbedc3fa AS builder
WORKDIR /app
# Compile sqlx's `query!` macros against the committed offline cache (the single
# workspace-root .sqlx, generated by `cargo sqlx prepare --workspace`) instead of
# a live database — there is no DB at image-build time.
ENV SQLX_OFFLINE=true
COPY Cargo.toml Cargo.lock ./
COPY .sqlx ./.sqlx
COPY server ./server
RUN cargo build --release -p opswarden-server

# ---- runtime ----
FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates wget \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 opswarden \
    && useradd --system --uid 10001 --gid opswarden --no-create-home opswarden
WORKDIR /app
COPY --from=builder /app/target/release/opswarden-server /usr/local/bin/opswarden-server
USER 10001:10001
EXPOSE 8080
CMD ["opswarden-server"]
