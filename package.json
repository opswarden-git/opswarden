{
  "name": "opswarden",
  "private": true,
  "workspaces": [
    "client-web",
    "client-desktop"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "lint:css": "stylelint \"client-web/**/*.css\" --config client-web/stylelint.config.mjs",
    "knip": "knip --config client-web/knip.json",
    "knip:production": "knip --config client-web/knip.json --production --workspace client-web --include dependencies,unlisted,binaries,unresolved"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "brace-expansion": "1.1.18",
    "knip": "^5.30.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.1"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "postcss": "^8.5.15"
  }
}
