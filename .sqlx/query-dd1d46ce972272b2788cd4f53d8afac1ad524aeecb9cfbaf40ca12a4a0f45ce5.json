  "query": "\n            SELECT id, incident_id, author_id, content, created_at, edited_at\n            FROM timeline_entries\n            WHERE incident_id = $1\n              AND ($2::timestamptz IS NULL OR (created_at, id) < ($2, $3))\n            ORDER BY created_at DESC, id DESC\n            LIMIT $4\n            ",
