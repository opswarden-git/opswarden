  "query": "\n        SELECT image.media_type, image.content, image.updated_at\n        FROM team_images image\n        WHERE image.team_id = $1\n          AND EXISTS (\n              SELECT 1 FROM team_members member\n              WHERE member.team_id = image.team_id AND member.user_id = $2\n          )\n        ",
